    "components": {
        "schemas": {
            "Activity": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "start_date_local": { "type": "string" },
                    "type": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "distance": { "type": "number" },
                    "moving_time": { "type": "integer" },
                    "elapsed_time": { "type": "integer" },
                    "total_elevation_gain": { "type": "number" },
                    "average_watts": { "type": "number" },
                    "weighted_average_watts": { "type": "number" },
                    "average_hr": { "type": "number" },
                    "max_hr": { "type": "number" },
                    "external_id": { "type": "string" }
                }
            },
            "Workout": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "updated": { "type": "string" }
                }
            },
            "Event": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer", "format": "int32" },
                    "start_date_local": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "type": { "type": "string" },
                    "workout_id": { "type": "string" }
                }
            },
            "Athlete": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "email": { "type": "string" }
                }
            },
            "UploadResponse": {
                "type": "object",
                "properties": {
                    "activities": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/Activity" }
                    }
                }
            }
        },
        "securitySchemes": {
            "APIKey": {
                "type": "http",
                "scheme": "basic"
            },
            "AccessToken": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    }
}
