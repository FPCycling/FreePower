                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Activity" } }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/activity/{id}": {
            "get": {
                "tags": ["Activities"],
                "summary": "Get an activity",
