                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Activity" } } },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Activity" } } }
                    }
                }
            }
        },
        "/api/v1/athlete/{id}/activities/manual/bulk": {
            "post": {
